NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_IMMEDIATELY
MAX_UPLOAD_MB=15
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=./storage/backups
UPLOAD_DIR=./storage/uploads
# On Render, local disk is ephemeral. Use a persistent disk or S3-compatible object storage
# for real medical attachments and backups.
